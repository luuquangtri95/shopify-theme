{% assign id_section = section.id %}

{% comment %} slider {% endcomment %}
{% if section.settings.block_or_slider == 'slideshow' %}
  <div class="slideshow {{ id_section }}">
    {% for block in section.blocks %}
      {% if block.type == 'slideshow' %}
        <div class="slide {% if section.settings.option_for_slider == 'scale_equal' %} relative {% endif %}">
          {% if block.settings.image != blank %}
            <div class="{% if section.settings.option_for_slider == 'scale_equal' %} relative pt-[100%] {% endif %}">
              <img
                src="{{ block.settings.image | img_url: 'large' }}"
                alt="{{ block.settings.alt_text | default: 'Default image' }}"
                width="100%"
                height="100%"
                class="{% if section.settings.option_for_slider == 'scale_equal' %} absolute top-0 left-0 object-cover w-full h-full {% endif %}"
              >
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <script>
     document.addEventListener('DOMContentLoaded', function () {
     var slider = tns({
      container: '.{{ id_section }}',
      items: 1,
      slideBy: 'page',
      autoplay: {% if section.settings.auto_play == 'auto_play_on' %} true {% else %} false {% endif %},
      autoplayTimeout: 1000,
      autoplayButtonOutput: false,
      controls: false,
      nav: false,
      gutter: 10,
      loop: false,
    });
     });
  </script>
{% endif %}

{% comment %} block static {% endcomment %}
{% if section.settings.block_or_slider == 'image_banner' %}
  <div class="block-container">
    {% for block in section.blocks %}
      {% if block.type == 'image_banner' %}
        <div class="block-content h-[300px] relative" style="background-color: {{ block.settings.block_background }}">
          <img
            src="{{block.settings.image | img_url: 'large' }}"
            alt="{{ block.settings.alt_text | default: 'Default image' }}"
            width="100%"
            height="100%"
            class="absolute top-0 left-0 w-full h-full object-cover"
          >
          <p>{{ block.settings.block_text }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Custom block",
  "settings": [
    {
      "type": "radio",
      "id": "block_or_slider",
      "label": "Choose block or slider",
      "options": [
        {
          "value": "slideshow",
          "label": "Slideshow"
        },
        {
          "value": "image_banner",
          "label": "Image Banner"
        }
      ],
      "default": "slideshow"
    },
    {
      "type": "radio",
      "id": "option_for_slider",
      "label": "Option slide with ratio for slideshow",
      "options": [
        {
          "value": "scale_with_ratio",
          "label": "scale with ratio"
        },
        {
          "value": "scale_equal",
          "label": "scale equal"
        }
      ],
      "default": "scale_equal"
    },
    {
      "type": "radio",
      "id": "auto_play",
      "label": "Option slide with type autoplay",
      "options": [
        {
          "value": "auto_play_on",
          "label": "auto play active"
        },
        {
          "value": "auto_play_off",
          "label": "auto play disable"
        }
      ],
      "default": "auto_play_on"
    }
  ],
  "blocks": [
    {
      "type": "slideshow",
      "name": "image for slideshow",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Slide Image"
        }
      ]
    },
    {
      "type": "image_banner",
      "name": "image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "block_text",
          "label": "Block Text",
          "default": "This is block content"
        },
        {
          "type": "color",
          "id": "block_background",
          "label": "Background Color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "settings": {
        "block_or_slider": "slideshow"
      }
    },
    {
      "name": "Image Banner",
      "settings": {
        "block_or_slider": "image_banner"
      }
    }
  ]
}
{% endschema %}
